{
  "name": "@keel/core",
  "version": "0.0.1",
  "description": "KEEL Platform Kernel: Tenancy, Authorisation, Event Model, and Control Gate contract",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./tenancy": {
      "import": "./dist/tenancy/index.js",
      "types": "./dist/tenancy/index.d.ts"
    },
    "./auth": {
      "import": "./dist/auth/index.js",
      "types": "./dist/auth/index.d.ts"
    },
    "./ledger": {
      "import": "./dist/ledger/index.js",
      "types": "./dist/ledger/index.d.ts"
    },
    "./control-gate": {
      "import": "./dist/control-gate/index.js",
      "types": "./dist/control-gate/index.d.ts"
    },
    "./types": {
      "import": "./dist/types/index.js",
      "types": "./dist/types/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:l3": "vitest",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write src",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "keel",
    "kernel",
    "tenancy",
    "authorisation",
    "rbac",
    "abac",
    "ledger",
    "event-sourcing"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "zod": "^3.22.0",
    "uuid": "^9.0.0",
    "decimal.js": "^10.4.0",
    "date-fns": "^2.30.0",
    "pino": "^8.16.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0",
    "eslint": "^8.54.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "prettier": "^3.1.0"
  }
}
