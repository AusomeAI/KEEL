{
  "name": "@keel/calc",
  "version": "0.0.1",
  "description": "KEEL Deterministic Calculation Kernel (Rust/WASM). Pure functions, no I/O, no clock, no randomness.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./wasm": {
      "import": "./dist/wasm_bg.wasm.js",
      "types": "./dist/wasm.d.ts"
    }
  },
  "scripts": {
    "build": "wasm-pack build --target bundler --release",
    "build:dev": "wasm-pack build --target bundler",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src"
  },
  "dependencies": {
    "@keel/policy": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.52.0",
    "prettier": "^3.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.4",
    "wasm-pack": "^1.3.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "sideEffects": false
}
