{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022"],
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "baseUrl": ".",
    "paths": {
      "@keel/core": ["packages/core/src"],
      "@keel/core/*": ["packages/core/src/*"],
      "@keel/policy": ["packages/policy/src"],
      "@keel/policy/*": ["packages/policy/src/*"],
      "@keel/calc": ["packages/calc/src"],
      "@keel/calc/*": ["packages/calc/src/*"],
      "@keel/design-system": ["packages/design-system/src"],
      "@keel/design-system/*": ["packages/design-system/src/*"],
      "@keel/sdk": ["packages/sdk/src"],
      "@keel/sdk/*": ["packages/sdk/src/*"],
      "@keel/testing": ["packages/testing/src"],
      "@keel/testing/*": ["packages/testing/src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "build", ".next", "coverage"]
}
